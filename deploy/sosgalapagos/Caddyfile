# Proxy de origen detrás de Cloudflare.
# Certificado de Let's Encrypt (HTTP-01 a través de Cloudflare). En Cloudflare,
# SSL/TLS debe estar en «Full (strict)».
{
	servers {
		# Solo Cloudflare llega a este servidor (ver firewall-cloudflare.sh).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers Cf-Connecting-Ip
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		-Server
	}

	# API (NestJS) bajo /backend: Caddy quita el prefijo.
	handle_path /backend/* {
		reverse_proxy api:3000
	}

	# Capas del mapa y logos: cacheables en el navegador y en Cloudflare.
	# «>» reemplaza el Cache-Control que manda Next (max-age=0) en vez de
	# duplicarlo. /_next/static ya llega como immutable desde Next.
	@estaticos path /capas/* /marca/* /videos/*
	header @estaticos >Cache-Control "public, max-age=3600, stale-while-revalidate=86400"

	# Mapas y capas descargables: archivos estáticos fuera del repo, en
	# /srv/sosgalapagos-mapas (los publica geodatos/scripts/publicar_mapas.sh).
	redir /mapas /mapas/ permanent
	handle_path /mapas/* {
		root * /srv/mapas
		# La página y sus índices se revalidan siempre (ETag): un cambio se ve al instante.
		@indices path / /index.html *.json
		header @indices Cache-Control "no-cache"
		@archivos not path / /index.html *.json
		header @archivos Cache-Control "public, max-age=600, stale-while-revalidate=86400"
		@geojson path *.geojson
		header @geojson Content-Type "application/geo+json; charset=utf-8"
		@zip path *.zip
		header @zip Content-Type application/zip
		file_server {
			precompressed gzip
		}
	}

	handle {
		reverse_proxy web:3001
	}
}
