# SOS Galápagos — variables de producción. Copiar a .env (NUNCA subirlo a git).
# Generar secretos con: openssl rand -hex 32

SITE_DOMAIN=sosgalapagos.org
SITE_URL=https://sosgalapagos.org
# Postgres
POSTGRES_USER=sosgalapagos
POSTGRES_PASSWORD=
POSTGRES_DB=sosgalapagos

# API
JWT_SECRET=
# Secreto compartido web↔API para reenviar la IP real del usuario (rate limit por persona)
INTERNAL_PROXY_SECRET=

# Web
SESSION_MAX_AGE_SECONDS=604800

# Opcional: inicio de sesión con Google / Facebook (ver README, «Google y Facebook»).
# SOCIAL_LOGIN muestra los botones; ponlo solo cuando las credenciales estén cargadas.
#   Google   → callback: ${SITE_URL}/backend/auth/google/callback
#   Facebook → callback: ${SITE_URL}/backend/auth/facebook/callback
SOCIAL_LOGIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
